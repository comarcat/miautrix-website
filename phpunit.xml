<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         executionOrder="random"
         failOnWarning="true"
         failOnRisky="true"
         beStrictAboutOutputDuringTests="true">
    <testsuites>
        <!-- Rooted at tests/ only, so the blueprint bundle under blueprints/ is never collected. -->
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
        <exclude>
            <directory>blueprints</directory>
            <directory>vendor</directory>
        </exclude>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_DEBUG" value="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>

        <!-- Tests run against a REAL PostgreSQL, in a separate database from dev/prod.
             Never SQLite: the schema uses PostgreSQL-specific indexes and constraints that
             SQLite silently accepts. As of 2026-09-08 this points at the network Postgres at
             172.16.101.12 (owner-run server, PostgreSQL 17.11 — not yet the blueprint's pinned
             18; noted as an accepted deviation, not fixed here). docker-compose.yml's local
             postgres:18.6 on port 5433 remains the fallback for a dev machine with no network
             access to that host — swap these five values back to it if so. -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="172.16.101.12"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="miautrix_test"/>
        <env name="DB_USERNAME" value="miau_db"/>
        <env name="DB_PASSWORD" value="Miausito2024"/>

        <env name="CACHE_STORE" value="array"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="PULSE_ENABLED" value="false"/>
    </php>
</phpunit>
