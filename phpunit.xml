<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         executionOrder="random"
         failOnWarning="true"
         failOnRisky="true"
         beStrictAboutOutputDuringTests="true">
    <testsuites>
        <!-- Rooted at tests/ only, so the blueprint bundle under blueprints/ is never collected. -->
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
        <exclude>
            <directory>blueprints</directory>
            <directory>vendor</directory>
        </exclude>
    </source>
    <php>
        <!-- force="true" on every entry below: infra/deploy.sh's documented usage is
             `set -a; . ./.env; set +a` BEFORE running it, which exports the real .env (including
             production-shaped values like SESSION_ENCRYPT) into the shell that then runs this
             gate. Without force, PHPUnit leaves an already-set OS env var alone instead of
             overriding it — Pest then silently ran against real config instead of these testing
             values, producing 419 CSRF failures and missing-notification failures that took a
             real deploy run to surface. Tests must never be fragile to the caller's shell state. -->
        <env force="true" name="APP_ENV" value="testing"/>
        <env force="true" name="APP_DEBUG" value="true"/>
        <env force="true" name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env force="true" name="BCRYPT_ROUNDS" value="4"/>

        <!-- Tests run against a REAL PostgreSQL, in a separate database from dev/prod.
             Never SQLite: the schema uses PostgreSQL-specific indexes and constraints that
             SQLite silently accepts. As of 2026-09-08 this points at the network Postgres at
             172.16.101.12 (owner-run server, PostgreSQL 17.11 — not yet the blueprint's pinned
             18; noted as an accepted deviation, not fixed here). docker-compose.yml's local
             postgres:18.6 on port 5433 remains the fallback for a dev machine with no network
             access to that host — swap these five values back to it if so. -->
        <env force="true" name="DB_CONNECTION" value="pgsql"/>
        <env force="true" name="DB_HOST" value="172.16.101.12"/>
        <env force="true" name="DB_PORT" value="5432"/>
        <env force="true" name="DB_DATABASE" value="miautrix_test"/>
        <env force="true" name="DB_USERNAME" value="miau_db"/>
        <env force="true" name="DB_PASSWORD" value="Miausito2024"/>

        <env force="true" name="CACHE_STORE" value="array"/>
        <env force="true" name="SESSION_DRIVER" value="array"/>
        <env force="true" name="QUEUE_CONNECTION" value="sync"/>
        <env force="true" name="MAIL_MAILER" value="array"/>
        <env force="true" name="TELESCOPE_ENABLED" value="false"/>
        <env force="true" name="PULSE_ENABLED" value="false"/>

        <!-- Required from E2-T7 onward: DatabaseSeeder throws if either is unset, and CI's
             .env comes from .env.example (deliberately blank secrets), not the real .env this
             dev machine has. SeederTest calls $this->seed(DatabaseSeeder::class) directly, so
             it needs these regardless of what CI's job-level `env:` block does or doesn't set. -->
        <env force="true" name="ADMIN_SEED_EMAIL" value="admin@example.test"/>
        <env force="true" name="ADMIN_SEED_PASSWORD" value="testing-only-not-a-real-password"/>
    </php>
</phpunit>
