##
## miautrix-website — committed template. Every key present, every secret blank.
## `.env` is derived from this file in blueprint §10 Bootstrap and is never committed.
## The "step" comment on each block is the blueprint §9 step from which the variable is REQUIRED.
## Before that step the boot validator treats it as optional.
##

# --- step 1: application core -------------------------------------------------
APP_NAME="miautrix"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8123
APP_TIMEZONE=UTC
APP_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- step 1: database (docker-compose.yml provides these locally, port 5433) --
# If DB_HOST is ever pointed at the same network Postgres server production uses (see
# infra/deploy.sh's DB_HOST), DB_DATABASE must NOT also be the same name production's
# shared/.env uses. Task verify steps run `php artisan migrate:fresh`, which drops every
# table — sharing prod's database name means periodically wiping production. This bit the
# project once (2026-09-08, E2-T4 kickoff) before anything had been seeded; use a distinct
# name like miautrix_dev when working against the network server directly.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=miautrix_website
DB_USERNAME=miautrix
DB_PASSWORD=miautrix

# Test database. phpunit.xml overrides these for Pest; tests never share a database with dev.
TEST_DATABASE_URL=pgsql://miautrix:miautrix@127.0.0.1:5433/miautrix_test

# --- step 1: queue, cache, session — database driver, NO Redis ---------------
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# --- step 16: storage --------------------------------------------------------
FILESYSTEM_DISK=local
# Uploads live OUTSIDE the web root and are served by MediaController.
MEDIA_DISK=private-media

# --- step 10: mail (fortify password reset + contact form relay) ------------
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.invalid"
MAIL_FROM_NAME="${APP_NAME}"
CONTACT_TO_ADDRESS="owner@example.invalid"

# --- step 13: debug tooling. Telescope is LOCAL ONLY. ------------------------
TELESCOPE_ENABLED=false

# --- step 2: GitHub automation (the gh CLI is NOT used — REST API via curl) --
GITHUB_REPO_URL=
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=miautrix-website

# --- step 4: deployment target (Debian 13 LXC). Shell-only. ------------------
LXC_HOST=
LXC_SSH_KEY=
DEPLOY_PATH=/var/www/miautrix
DEPLOY_USER=deploy
DEPLOY_PORT=22
# Public hostname of the production site (no scheme). Used by infra/deploy.sh, the step-5 HTTPS
# check, the sitemap generator, and the SEO audit command.
APP_DOMAIN=127.0.0.1:8123

# --- step 12: seeded super_admin (change the password after first login) ----
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
