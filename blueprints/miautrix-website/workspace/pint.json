{
    "preset": "laravel",
    "exclude": [
        "blueprints",
        "bootstrap/cache",
        "node_modules",
        "public/build",
        "storage",
        "vendor"
    ],
    "rules": {
        "ordered_imports": {
            "sort_algorithm": "alpha"
        },
        "no_unused_imports": true,
        "concat_space": {
            "spacing": "one"
        }
    }
}
