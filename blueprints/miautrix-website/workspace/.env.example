##
## miautrix-website — committed template. Every key present, every secret blank.
## `.env` is derived from this file in blueprint §10 Bootstrap and is never committed.
## The "step" comment on each block is the blueprint §9 step from which the variable is REQUIRED.
## Before that step the boot validator (config/required_env.php) treats it as optional.
##

# --- step 1: application core -------------------------------------------------
APP_NAME="miautrix"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=UTC
APP_LOCALE=en

# Public hostname of the production site. Used by infra/deploy.sh, the step-5 HTTPS check,
# the sitemap generator and the SEO audit command. Local value is the loopback host.
APP_DOMAIN=127.0.0.1:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- step 6: database (docker-compose.yml provides these locally) -------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=miautrix
DB_USERNAME=miautrix
DB_PASSWORD=miautrix

# Test database. phpunit.xml overrides DB_DATABASE with this value; tests never
# share a database with development.
TEST_DB_DATABASE=miautrix_test

# --- step 6: cache, session and queue (Redis 8 from docker-compose.yml) -------
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=redis

# --- step 16: storage --------------------------------------------------------
FILESYSTEM_DISK=local
# Uploads live OUTSIDE the web root and are served by MediaController.
MEDIA_DISK=media_private

# --- step 21: mail (contact form). `log` needs no credentials and no account. --
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.invalid"
MAIL_FROM_NAME="${APP_NAME}"
CONTACT_TO_ADDRESS="owner@example.invalid"

# --- step 13: debug tooling. Telescope is LOCAL ONLY. ------------------------
TELESCOPE_ENABLED=false

# --- step 24: queue dashboard ------------------------------------------------
HORIZON_PATH=horizon

# --- step 2/3: GitHub automation. Shell-only — the application never reads these.
# Fine-grained PAT with Administration:write and Contents:write on this repository.
# https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=miautrix-website

# --- step 4/5/24: deployment target. Shell-only. -----------------------------
DEPLOY_HOST=
DEPLOY_USER=deploy
DEPLOY_PORT=22
DEPLOY_PATH=/var/www/miautrix
# rsync destination for nightly off-host backups, e.g. user@backuphost:/srv/backups/miautrix
BACKUP_TARGET=
