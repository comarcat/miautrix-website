{
  "_readme": "PHASE 2 MERGE TARGET. The repo already has .claude/settings.json; Bootstrap's guarded rsync will NOT overwrite it. Merge the `allow` entries below into the existing file's permissions.allow (they are a superset of the Phase-1 list plus what every Phase-2 §9 Verify command needs), and merge the `deny` entries. This block covers: ./vendor/bin/pint|phpstan|pest, php artisan (migrate, db:seed), php -r (symfony/yaml parse check), composer (incl. composer require for barryvdh/laravel-dompdf and geoip2/geoip2), npm ci|install|run, curl (live verify), git (incl. check-ignore, tag), bash infra/* (deploy-staging.sh, host-parity-check.sh), grep|test|find. No .claude/commands/. No new .claude/skills/.",
  "permissions": {
    "allow": [
      "Bash(./vendor/bin/pint:*)",
      "Bash(./vendor/bin/phpstan:*)",
      "Bash(./vendor/bin/pest:*)",
      "Bash(php artisan:*)",
      "Bash(APP_ENV=* php artisan:*)",
      "Bash(php -r:*)",
      "Bash(php -v)",
      "Bash(composer install:*)",
      "Bash(composer update:*)",
      "Bash(composer require:*)",
      "Bash(composer show:*)",
      "Bash(composer validate:*)",
      "Bash(composer audit:*)",
      "Bash(npm ci)",
      "Bash(npm install:*)",
      "Bash(npm run:*)",
      "Bash(npm audit:*)",
      "Bash(node -v)",
      "Bash(bash -n:*)",
      "Bash(bash infra/deploy-staging.sh:*)",
      "Bash(bash infra/host-parity-check.sh:*)",
      "Bash(bash infra/deploy.sh:*)",
      "Bash(bash infra/backup.sh:*)",
      "Bash(curl:*)",
      "Bash(ssh:*)",
      "Bash(rsync:*)",
      "Bash(jq:*)",
      "Bash(grep:*)",
      "Bash(test:*)",
      "Bash(find:*)",
      "Bash(cat:*)",
      "Bash(cp:*)",
      "Bash(mkdir:*)",
      "Bash(sleep:*)",
      "Bash(kill:*)",
      "Bash(wc:*)",
      "Bash(docker compose:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git tag:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-remote:*)",
      "Bash(git check-ignore:*)",
      "Bash(git rev-parse:*)",
      "Bash(git remote:*)",
      "Bash(git init:*)",
      "Bash(git push origin:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(php artisan migrate:fresh:*)",
      "Bash(php artisan db:wipe:*)",
      "Bash(docker compose down -v:*)",
      "Bash(rm -rf /:*)"
    ]
  }
}
